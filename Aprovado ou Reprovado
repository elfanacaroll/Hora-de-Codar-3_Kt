fun main() {
    var aprovados = 0  // contador de alunos aprovados
    var resposta: String

    do {
        print("Digite a primeira nota: ")
        val nota1 = readLine()!!.toDouble()

        print("Digite a segunda nota: ")
        val nota2 = readLine()!!.toDouble()

        val media = (nota1 + nota2) / 2
        println("Média final: $media")

        if (media >= 9.5) {
            println("Aprovado!!!")
            aprovados++
        } else {
            println(" Reprovado :(")
        }

        print("Calcular a média de outro aluno? (S/N): ")
        resposta = readLine()!!.uppercase()

    } while (resposta == "S")

    println("\nQuantidade de alunos aprovados: $aprovados")
}
