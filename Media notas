fun main() {
    var soma = 0.0
    var nota: Double

    for (i in 1..6) {
        do {
            print("Digite a nota $i (0 a 10): ")
            nota = readLine()!!.toDouble()

            if (nota < 0 || nota > 10) {
                println("Valor inválido! Digite novamente.")
            }
        } while (nota < 0 || nota > 10)

        soma += nota
    }

    val media = soma / 6
    println("\nA média final do aluno é: $media")
}
